{
  "name": "Video Transcript",
  "zipPrefix": "video-transcript",
  "zipDir": ".",
  "versionFrom": "manifest.json",
  "versionFiles": [
    "manifest.json",
    "manifest.edge.json",
    "manifest.firefox.json",
    "package.json"
  ],
  "listing": "store/listing.md",
  "readme": "README.md",
  "lint": {
    "forbidden": [],
    "textFiles": [
      "scripts/store-images/screenshots.ts",
      "scripts/store-images/promo.mjs"
    ],
    "packageScript": "scripts/package-stores.mjs"
  },
  "manifests": [
    "manifest.json",
    "manifest.edge.json",
    "manifest.firefox.json"
  ],
  "images": [
    {
      "path": "store/images/icon-128x128.png",
      "size": "128x128"
    },
    {
      "path": "store/images/logo-300x300.png",
      "size": "300x300"
    },
    {
      "path": "store/images/screenshot-01-transcript.png",
      "size": "1280x800"
    },
    {
      "path": "store/images/screenshot-02-search.png",
      "size": "1280x800"
    },
    {
      "path": "store/images/screenshot-03-export.png",
      "size": "1280x800"
    },
    {
      "path": "store/images/screenshot-04-pasted-url.png",
      "size": "1280x800"
    },
    {
      "path": "store/images/screenshot-05-settings.png",
      "size": "1280x800"
    },
    {
      "path": "store/images/tile-440x280.png",
      "size": "440x280"
    },
    {
      "path": "store/images/marquee-1400x560.png",
      "size": "1400x560"
    }
  ],
  "stores": {
    "chrome": {
      "id": "ahddbfbjafmbceehebpeanpnlbaimepk",
      "url": "https://chromewebstore.google.com/detail/ahddbfbjafmbceehebpeanpnlbaimepk",
      "dashboard": "https://chrome.google.com/webstore/devconsole",
      "apiDocs": "https://developer.chrome.com/docs/webstore/using-api",
      "env": [
        "CWS_CLIENT_ID",
        "CWS_CLIENT_SECRET",
        "CWS_REFRESH_TOKEN",
        "CWS_PUBLISHER_ID"
      ],
      "notes": "Listing text, screenshots and privacy answers are edited in the dashboard; answers are kept in store/privacy-fields.md"
    },
    "edge": {
      "id": "069ca91d-a7cd-4bac-8224-1ee38a2d2a06",
      "crxId": "jkcfajddmmeapfabpoekfiemnbdaofeo",
      "url": "https://microsoftedge.microsoft.com/addons/detail/video-transcript/jkcfajddmmeapfabpoekfiemnbdaofeo",
      "dashboard": "https://partner.microsoft.com/en-us/dashboard/microsoftedge/069ca91d-a7cd-4bac-8224-1ee38a2d2a06/packages/dashboard",
      "apiDocs": "https://learn.microsoft.com/microsoft-edge/extensions/update/api/using-addons-api",
      "env": [
        "EDGE_API_KEY",
        "EDGE_CLIENT_ID"
      ],
      "expires": "2026-11-21",
      "notes": "Chromium build with manifest.edge.json: no tabCapture or offscreen, the built-in model has no audio input there. Renew the key at https://partner.microsoft.com/en-us/dashboard/microsoftedge/publishapi and update it in both extension repos"
    },
    "firefox": {
      "id": "video-transcript@qyl.at",
      "slug": "video-transcript",
      "icon": "store/images/logo-300x300.png",
      "previews": [
        "store/images/screenshot-01-transcript.png",
        "store/images/screenshot-02-search.png",
        "store/images/screenshot-03-export.png",
        "store/images/screenshot-04-pasted-url.png",
        "store/images/screenshot-05-settings.png"
      ],
      "url": "https://addons.mozilla.org/firefox/addon/video-transcript/",
      "dashboard": "https://addons.mozilla.org/developers/addon/video-transcript/edit",
      "apiDocs": "https://mozilla.github.io/addons-server/topics/api/addons.html",
      "env": [
        "AMO_JWT_ISSUER",
        "AMO_JWT_SECRET"
      ],
      "notes": "One API key pair per Mozilla account, shared with the other extension repo; a new key invalidates the old one everywhere. The listing text is applied from store/listing.md"
    }
  }
}
